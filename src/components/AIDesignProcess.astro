---
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

const q = (s: string) => s.replace(/"/g, '#quot;')

const diagram = [
  'flowchart TD',
  `  subgraph s1["${q(t('ai.flow.subgraph1'))}"]`,
  `    spec["${q(t('ai.flow.node.spec'))}"]`,
  `    ticket["${q(t('ai.flow.node.ticket'))}"]`,
  '    spec --> ticket',
  '  end',
  `  subgraph s2["${q(t('ai.flow.subgraph2'))}"]`,
  `    ctx["${q(t('ai.flow.node.context'))}"]`,
  `    layers["${q(t('ai.flow.node.context.detail'))}"]`,
  '    ctx --> layers',
  '  end',
  `  subgraph s3["${q(t('ai.flow.subgraph3'))}"]`,
  `    exec["${q(t('ai.flow.node.execute'))}"]`,
  `    review["${q(t('ai.flow.node.review'))}"]`,
  `    sync["${q(t('ai.flow.node.sync'))}"]`,
  '    exec --> review --> sync',
  '  end',
  '  ticket --> ctx',
  '  layers --> exec',
  `  sync -->|"${q(t('ai.flow.cycle'))}"| ticket`,
].join('\n')

const flowId     = `ai-flow-${lang}`
const containerId = `mermaid-${lang}`

const steps = [
  {
    tool:   t('ai.step1.tool'),
    role:   t('ai.step1.role'),
    detail: t('ai.step1.detail'),
    accent: 'var(--accent-from)',
  },
  {
    tool:   t('ai.step2.tool'),
    role:   t('ai.step2.role'),
    detail: t('ai.step2.detail'),
    accent: 'var(--tag-violet)',
  },
  {
    tool:   t('ai.step3.tool'),
    role:   t('ai.step3.role'),
    detail: t('ai.step3.detail'),
    accent: 'var(--accent-to)',
  },
]
---

<section aria-labelledby="ai-design-heading" style="color: var(--text-primary);">
  <header style="margin-bottom: 2rem;">
    <h2
      id="ai-design-heading"
      style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem;"
    >
      {t('ai.heading')}
    </h2>
    <p style="color: var(--text-secondary); line-height: 1.7; max-width: 60ch;">
      {t('ai.intro')}
    </p>
  </header>

  <div style="margin-bottom: 2.5rem;">
    <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.5rem;">
      {t('ai.workflow.heading')}
    </h3>

    <figure
      class="mermaid-flow-wrap"
      style="border: var(--border-width) solid var(--border); border-radius: var(--radius); background: var(--bg-surface); padding: 1rem; margin-bottom: 1.5rem; overflow-x: auto;"
    >
      <div
        id={containerId}
        class="mermaid-flow"
        aria-label={t('ai.flow.aria')}
        role="img"
      />
    </figure>

    <ol style="list-style: none; padding: 0; margin: 0;">
      {steps.map((s, i) => (
        <li style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="display: flex; flex-direction: column; align-items: center; flex-shrink: 0;">
            <div style={`width: 32px; height: 32px; border-radius: 50%; background: ${s.accent}; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: var(--on-accent); font-family: var(--font-mono);`}>
              {i + 1}
            </div>
            {i < steps.length - 1 && (
              <div style="width: 2px; height: 40px; background: var(--border); margin-top: 4px;" aria-hidden="true" />
            )}
          </div>

          <div style={`padding-bottom: ${i < steps.length - 1 ? '1.5rem' : '0'};`}>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span style={`font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: ${s.accent};`}>
                {s.tool}
              </span>
              <span style="font-size: 13px; color: var(--text-secondary);">
                — {s.role}
              </span>
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin: 0;">
              {s.detail}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div
    style="border: var(--border-width) solid var(--border); border-radius: var(--radius); padding: 1.5rem; background: var(--bg-surface); margin-bottom: 2.5rem;"
  >
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem;">
      {t('ai.sdd.heading')}
    </h3>
    <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem;">
      {t('ai.sdd.intro')}
    </p>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
      {[t('ai.sdd.p1'), t('ai.sdd.p2'), t('ai.sdd.p3')].map(item => (
        <li style="display: flex; gap: 0.5rem; font-size: 13px; color: var(--text-secondary); line-height: 1.6;">
          <span style="color: var(--accent-from); flex-shrink: 0;" aria-hidden="true">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p style="font-size: 13px; color: var(--text-secondary); font-family: var(--font-mono); line-height: 1.6; margin: 1rem 0 0;">
      {t('ai.sdd.p4')}
    </p>
  </div>

  <div
    style="border: var(--border-width) solid var(--border); border-radius: var(--radius); padding: 1.5rem; background: var(--bg-surface); margin-bottom: 1.5rem;"
  >
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem;">
      {t('ai.handoff.heading')}
    </h3>
    <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 0.75rem;">
      {t('ai.handoff.p1')}
    </p>
    <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin: 0;">
      {t('ai.handoff.p2')}
    </p>
  </div>

  <p style="font-size: 13px; color: var(--text-secondary); font-family: var(--font-mono);">
    {t('ai.handoff.p3')}
  </p>
</section>

<script define:vars={{ diagram, flowId, containerId }}>
  import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
    .then(({ default: mermaid }) => {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'neutral',
        securityLevel: 'loose',
        flowchart: { curve: 'basis', htmlLabels: true },
      })
      return mermaid.render(flowId, diagram)
    })
    .then(({ svg }) => {
      const el = document.getElementById(containerId)
      if (el) el.innerHTML = svg
    })
    .catch(() => {})
</script>

<style>
  .mermaid-flow-wrap :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  @media print {
    .mermaid-flow-wrap { break-inside: avoid; }
  }
</style>
